# Database Connection URL
# For local SQLite: sqlite:///./pdf_documents.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/dbname
DATABASE_URL=sqlite:///./pdf_documents.db

# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# Allowed CORS Origins (comma separated)
# E.g., http://localhost:5173,https://your-production-app.com
ALLOWED_ORIGINS=http://localhost:5173

# PDF Preprocessor Microservice (Go)
# Internal container/service URL:
PREPROCESSOR_URL=http://localhost:8001
# Public browser-accessible URL for thumbnail images:
PREPROCESSOR_PUBLIC_URL=http://localhost:8001
